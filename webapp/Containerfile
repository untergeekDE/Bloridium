# Bloridium Web-App – Blofeld-Dump -> Iridium-.qpat (Upload, ZIP, Match-Schaetzung)
# Build-Kontext ist das Repo-Root:
#   podman build -f webapp/Containerfile -t bloridium-web .   (docker build -f … works the same)
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DATA_DIR=/data \
    BLORIDIUM_CORE_DIR=/app/core \
    BLORIDIUM_TEMPLATE=/app/template_waveform.qpat

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY webapp/requirements.txt ./
RUN pip install -r requirements.txt

# App + pure-python core modules (no mido/rtmidi; prognose needs numpy only).
# The RF model (models/prognose_rf.pkl, ~0.9 MB, git-tracked since 64c73e3) is baked in
# at /app/models/, where matching.resolve_model_path() finds it. To use another model,
# mount over it: -v <dir>:/app/models:ro  or set BLORIDIUM_MODEL=/path/to/model.pkl
COPY webapp/app.py webapp/convert.py webapp/matching.py webapp/midi_file.py webapp/ratelimit.py ./
COPY webapp/static ./static
COPY bloridium/blofeld_dump.py bloridium/qpat.py bloridium/qpat_map.py bloridium/waldorf.py bloridium/prognose.py bloridium/version.py ./core/
COPY docs/refs/qpat/template_waveform.qpat ./template_waveform.qpat
COPY models/prognose_rf.pkl ./models/prognose_rf.pkl

RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "120", "app:app"]
